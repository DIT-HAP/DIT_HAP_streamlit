{"attributeDeclarations":[{"nodes":{"KEGG_NODE_WIDTH":{"d":"string"},"KEGG_LINK":{"d":"string"},"KEGG_DEFINITION":{"d":"string"},"KEGG_NODE_HEIGHT":{"d":"string"},"KEGG_NODE_LABEL_COLOR":{"d":"string"},"KEGG_NODE_LABEL_LIST_FIRST":{"d":"string"},"KEGG_NODE_TYPE":{"d":"string"},"KEGG_NODE_LABEL":{"d":"string"},"KEGG_NODE_REACTIONID":{"d":"string"},"name":{"d":"string"},"KEGG_NODE_LABEL_LIST":{"d":"list_of_string"},"KEGG_ID":{"d":"list_of_string"},"KEGG_NODE_Y":{"d":"string"},"KEGG_NODE_SHAPE":{"d":"string"},"KEGG_NODE_X":{"d":"string"},"selected":{"d":"boolean"},"KEGG_NODE_FILL_COLOR":{"d":"string"}},"networkAttributes":{"KEGG_PATHWAY_IMAGE":{"d":"string"},"KEGG_PATHWAY_ORG":{"d":"string"},"modules_id":{"d":"list_of_string"},"__Annotations":{"d":"list_of_string"},"KEGG_PATHWAY_ID":{"d":"string"},"classes":{"d":"list_of_string"},"description":{"d":"string"},"diseases":{"d":"list_of_string"},"diseases_id":{"d":"list_of_string"},"KEGG_PATHWAY_LINK":{"d":"string"},"modules":{"d":"list_of_string"},"shared name":{"d":"string"},"name":{"d":"string"},"selected":{"d":"boolean"}},"edges":{"shared name":{"d":"string"},"KEGG_RELATION_TYPE":{"d":"string"},"KEGG_REACTION_TYPE":{"d":"string"},"KEGG_EDGE_COLOR":{"d":"string"},"KEGG_EDGE_COLOR_BG":{"d":"string"},"shared interaction":{"d":"string"},"KEGG_REACTION_GENE":{"d":"string"},"name":{"d":"string"},"interaction":{"d":"string"},"KEGG_EDGE_SUBTYPES":{"d":"list_of_string"},"KEGG_EDGE_LABEL":{"d":"string"},"selected":{"d":"boolean"}}}]},
{"networkAttributes":[{"KEGG_PATHWAY_IMAGE":"https://www.kegg.jp/kegg/pathway/spo/spo03018.png","KEGG_PATHWAY_ORG":"spo","modules_id":[""],"KEGG_PATHWAY_ID":"path:spo03018","classes":["Genetic Information Processing","Folding, sorting and degradation"],"description":"The correct processing, quality control and turnover of cellular RNA molecules are critical to many aspects in the expression of genetic information. In eukaryotes, two major pathways of mRNA decay exist and both pathways are initiated by poly(A) shortening of the mRNA. In the 5' to 3' pathway, this is followed by decapping which then permits the 5' to 3' exonucleolytic degradation of transcripts. In the 3' to 5' pathway, the exosome, a large multisubunit complex, plays a key role. The exosome exists in archaeal cells, too. In bacteria, endoribonuclease E, a key enzyme involved in RNA decay and processing, organizes a protein complex called degradosome. RNase E or R interacts with the phosphate-dependent exoribonuclease polynucleotide phosphorylase, DEAD-box helicases, and additional factors in the RNA-degrading complex.","diseases":[""],"diseases_id":[""],"KEGG_PATHWAY_LINK":"https://www.kegg.jp/kegg-bin/show_pathway?spo03018","modules":[""],"name":"RNA degradation [spo03018]_1"}]},
