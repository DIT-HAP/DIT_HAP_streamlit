{"attributeDeclarations":[{"nodes":{"KEGG_NODE_WIDTH":{"d":"string"},"KEGG_LINK":{"d":"string"},"KEGG_DEFINITION":{"d":"string"},"KEGG_NODE_HEIGHT":{"d":"string"},"KEGG_NODE_LABEL_COLOR":{"d":"string"},"KEGG_NODE_LABEL_LIST_FIRST":{"d":"string"},"KEGG_NODE_TYPE":{"d":"string"},"KEGG_NODE_LABEL":{"d":"string"},"KEGG_NODE_REACTIONID":{"d":"string"},"name":{"d":"string"},"KEGG_NODE_LABEL_LIST":{"d":"list_of_string"},"KEGG_ID":{"d":"list_of_string"},"KEGG_NODE_Y":{"d":"string"},"KEGG_NODE_SHAPE":{"d":"string"},"KEGG_NODE_X":{"d":"string"},"selected":{"d":"boolean"},"KEGG_NODE_FILL_COLOR":{"d":"string"}},"networkAttributes":{"KEGG_PATHWAY_IMAGE":{"d":"string"},"KEGG_PATHWAY_ORG":{"d":"string"},"modules_id":{"d":"list_of_string"},"__Annotations":{"d":"list_of_string"},"KEGG_PATHWAY_ID":{"d":"string"},"classes":{"d":"list_of_string"},"description":{"d":"string"},"diseases":{"d":"list_of_string"},"diseases_id":{"d":"list_of_string"},"KEGG_PATHWAY_LINK":{"d":"string"},"modules":{"d":"list_of_string"},"shared name":{"d":"string"},"name":{"d":"string"},"selected":{"d":"boolean"}},"edges":{"shared name":{"d":"string"},"KEGG_RELATION_TYPE":{"d":"string"},"KEGG_REACTION_TYPE":{"d":"string"},"KEGG_EDGE_COLOR":{"d":"string"},"KEGG_EDGE_COLOR_BG":{"d":"string"},"shared interaction":{"d":"string"},"KEGG_REACTION_GENE":{"d":"string"},"name":{"d":"string"},"interaction":{"d":"string"},"KEGG_EDGE_SUBTYPES":{"d":"list_of_string"},"KEGG_EDGE_LABEL":{"d":"string"},"selected":{"d":"boolean"}}}]},
{"networkAttributes":[{"KEGG_PATHWAY_IMAGE":"https://www.kegg.jp/kegg/pathway/spo/spo02010.png","KEGG_PATHWAY_ORG":"spo","modules_id":[""],"KEGG_PATHWAY_ID":"path:spo02010","classes":["Environmental Information Processing","Membrane transport"],"description":"The ATP-binding cassette (ABC) transporters form one of the largest known protein families, and are widespread in bacteria, archaea, and eukaryotes. They couple ATP hydrolysis to active transport of a wide variety of substrates such as ions, sugars, lipids, sterols, peptides, proteins, and drugs. The structure of a prokaryotic ABC transporter usually consists of three components; typically two integral membrane proteins each having six transmembrane segments, two peripheral proteins that bind and hydrolyze ATP, and a periplasmic (or lipoprotein) substrate-binding protein. Many of the genes for the three components form operons as in fact observed in many bacterial and archaeal genomes. On the other hand, in a typical eukaryotic ABC transporter, the membrane spanning protein and the ATP-binding protein are fused, forming a multi-domain protein with the membrane-spanning domain (MSD) and the nucleotide-binding domain (NBD).","diseases":[""],"diseases_id":[""],"KEGG_PATHWAY_LINK":"https://www.kegg.jp/kegg-bin/show_pathway?spo02010","modules":[""],"name":"ABC transporters [spo02010]_1"}]},
