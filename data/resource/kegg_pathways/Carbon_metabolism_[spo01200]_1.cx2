{"attributeDeclarations":[{"nodes":{"KEGG_NODE_WIDTH":{"d":"string"},"KEGG_LINK":{"d":"string"},"KEGG_DEFINITION":{"d":"string"},"KEGG_NODE_HEIGHT":{"d":"string"},"KEGG_NODE_LABEL_COLOR":{"d":"string"},"KEGG_NODE_LABEL_LIST_FIRST":{"d":"string"},"KEGG_NODE_TYPE":{"d":"string"},"KEGG_NODE_LABEL":{"d":"string"},"KEGG_NODE_REACTIONID":{"d":"string"},"name":{"d":"string"},"KEGG_NODE_LABEL_LIST":{"d":"list_of_string"},"KEGG_ID":{"d":"list_of_string"},"KEGG_NODE_Y":{"d":"string"},"KEGG_NODE_SHAPE":{"d":"string"},"KEGG_NODE_X":{"d":"string"},"selected":{"d":"boolean"},"KEGG_NODE_FILL_COLOR":{"d":"string"}},"networkAttributes":{"KEGG_PATHWAY_IMAGE":{"d":"string"},"KEGG_PATHWAY_ORG":{"d":"string"},"modules_id":{"d":"list_of_string"},"__Annotations":{"d":"list_of_string"},"KEGG_PATHWAY_ID":{"d":"string"},"classes":{"d":"list_of_string"},"description":{"d":"string"},"diseases":{"d":"list_of_string"},"diseases_id":{"d":"list_of_string"},"KEGG_PATHWAY_LINK":{"d":"string"},"modules":{"d":"list_of_string"},"shared name":{"d":"string"},"name":{"d":"string"},"selected":{"d":"boolean"}},"edges":{"shared name":{"d":"string"},"KEGG_RELATION_TYPE":{"d":"string"},"KEGG_REACTION_TYPE":{"d":"string"},"KEGG_EDGE_COLOR":{"d":"string"},"KEGG_EDGE_COLOR_BG":{"d":"string"},"shared interaction":{"d":"string"},"KEGG_REACTION_GENE":{"d":"string"},"name":{"d":"string"},"interaction":{"d":"string"},"KEGG_EDGE_SUBTYPES":{"d":"list_of_string"},"KEGG_EDGE_LABEL":{"d":"string"},"selected":{"d":"boolean"}}}]},
{"networkAttributes":[{"KEGG_PATHWAY_IMAGE":"https://www.kegg.jp/kegg/pathway/spo/spo01200.png","KEGG_PATHWAY_ORG":"spo","modules_id":["Glycolysis (Embden-Meyerhof pathway), glucose => pyruvate [PATH:spo01200]","Glycolysis, core module involving three-carbon compounds [PATH:spo01200]","Pentose phosphate pathway (Pentose phosphate cycle) [PATH:spo01200]","PRPP biosynthesis, ribose-5P => PRPP [PATH:spo01200]","Pentose phosphate pathway, oxidative phase, glucose-6P => ribulose-5P [PATH:spo01200]","Pentose phosphate pathway, non-oxidative phase, fructose-6P => ribose-5P [PATH:spo01200]","Citrate cycle (TCA cycle, Krebs cycle) [PATH:spo01200]","Citrate cycle, first carbon oxidation, oxaloacetate => 2-oxoglutarate [PATH:spo01200]","Citrate cycle, second carbon oxidation, 2-oxoglutarate => oxaloacetate [PATH:spo01200]","Serine biosynthesis, glycerate-3P => serine [PATH:spo01200]","Cysteine biosynthesis, serine => cysteine [PATH:spo01200]","Pyruvate oxidation, pyruvate => acetyl-CoA [PATH:spo01200]","Glycine cleavage system [PATH:spo01200]"],"KEGG_PATHWAY_ID":"path:spo01200","classes":[""],"description":"Carbon metabolism is the most basic aspect of life. This map presents an overall view of central carbon metabolism, where the number of carbons is shown for each compound denoted by a circle, excluding a cofactor (CoA, CoM, THF, or THMPT) that is replaced by an asterisk. The map contains carbon utilization pathways of glycolysis (map00010), pentose phosphate pathway (map00030), and citrate cycle (map00020), and six known carbon fixation pathways (map00710 and map00720) as well as some pathways of methane metabolism (map00680). The six carbon fixation pathways are: (1) reductive pentose phosphate cycle (Calvin cycle) in plants and cyanobacteria that perform oxygenic photosynthesis, (2) reductive citrate cycle in photosynthetic green sulfur bacteria and some chemolithoautotrophs, (3) 3-hydroxypropionate bi-cycle in photosynthetic green nonsulfur bacteria, two variants of 4-hydroxybutyrate pathways in Crenarchaeota called (4) hydroxypropionate-hydroxybutyrate cycle and (5) dicarboxylate-hydroxybutyrate cycle, and (6) reductive acetyl-CoA pathway in methanogenic bacteria.","diseases":[""],"diseases_id":[""],"KEGG_PATHWAY_LINK":"https://www.kegg.jp/kegg-bin/show_pathway?spo01200","modules":["spo_M00001","spo_M00002","spo_M00004","spo_M00005","spo_M00006","spo_M00007","spo_M00009","spo_M00010","spo_M00011","spo_M00020","spo_M00021","spo_M00307","spo_M00621"],"name":"Carbon metabolism [spo01200]_1"}]},
