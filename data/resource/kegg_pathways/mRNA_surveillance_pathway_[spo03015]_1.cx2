{"attributeDeclarations":[{"nodes":{"KEGG_NODE_WIDTH":{"d":"string"},"KEGG_LINK":{"d":"string"},"NumChildren":{"d":"integer"},"KEGG_DEFINITION":{"d":"string"},"KEGG_NODE_HEIGHT":{"d":"string"},"KEGG_NODE_LABEL_COLOR":{"d":"string"},"KEGG_NODE_LABEL_LIST_FIRST":{"d":"string"},"KEGG_NODE_TYPE":{"d":"string"},"KEGG_NODE_LABEL":{"d":"string"},"NumDescendents":{"d":"integer"},"KEGG_NODE_REACTIONID":{"d":"string"},"name":{"d":"string"},"KEGG_NODE_LABEL_LIST":{"d":"list_of_string"},"KEGG_ID":{"d":"list_of_string"},"KEGG_NODE_Y":{"d":"string"},"KEGG_NODE_SHAPE":{"d":"string"},"KEGG_NODE_X":{"d":"string"},"selected":{"d":"boolean"},"KEGG_NODE_FILL_COLOR":{"d":"string"}},"networkAttributes":{"KEGG_PATHWAY_IMAGE":{"d":"string"},"KEGG_PATHWAY_ORG":{"d":"string"},"modules_id":{"d":"list_of_string"},"__Annotations":{"d":"list_of_string"},"KEGG_PATHWAY_ID":{"d":"string"},"classes":{"d":"list_of_string"},"description":{"d":"string"},"diseases":{"d":"list_of_string"},"diseases_id":{"d":"list_of_string"},"KEGG_PATHWAY_LINK":{"d":"string"},"modules":{"d":"list_of_string"},"shared name":{"d":"string"},"name":{"d":"string"},"selected":{"d":"boolean"}},"edges":{"shared name":{"d":"string"},"KEGG_RELATION_TYPE":{"d":"string"},"KEGG_REACTION_TYPE":{"d":"string"},"KEGG_EDGE_COLOR":{"d":"string"},"KEGG_EDGE_COLOR_BG":{"d":"string"},"shared interaction":{"d":"string"},"KEGG_REACTION_GENE":{"d":"string"},"name":{"d":"string"},"interaction":{"d":"string"},"KEGG_EDGE_SUBTYPES":{"d":"list_of_string"},"KEGG_EDGE_LABEL":{"d":"string"},"selected":{"d":"boolean"}}}]},
{"networkAttributes":[{"KEGG_PATHWAY_IMAGE":"https://www.kegg.jp/kegg/pathway/spo/spo03015.png","KEGG_PATHWAY_ORG":"spo","modules_id":[""],"KEGG_PATHWAY_ID":"path:spo03015","classes":["Genetic Information Processing","Translation"],"description":"The mRNA surveillance pathway is a quality control mechanism that detects and degrades abnormal mRNAs. These pathways include nonsense-mediated mRNA decay (NMD), nonstop mRNA decay (NSD), and no-go decay (NGD). NMD is a mechanism that eliminates mRNAs containing premature translation-termination codons (PTCs). In vertebrates, PTCs trigger efficient NMD when located upstream of an exon junction complex (EJC). Upf3, together with Upf1 and Upf2, may signal the presence of the PTC to the 5'end of the transcript, resulting in decapping and rapid exonucleolytic digestion of the mRNA. In the NSD pathway, which targets mRNAs lacking termination codons, the ribosome is believed to translate through the 3' untranslated region and stall at the end of the poly(A) tail. NSD involves an eRF3-like protein, Ski7p, which is hypothesized to bind the empty A site of the ribosome and recruit the exosome to degrade the mRNA from the 3' end. NGD targets mRNAs with stalls in translation elongation for endonucleolytic cleavage in a process involving the Dom34 and Hbs1 proteins.","diseases":[""],"diseases_id":[""],"KEGG_PATHWAY_LINK":"https://www.kegg.jp/kegg-bin/show_pathway?spo03015","modules":[""],"name":"mRNA surveillance pathway [spo03015]_1"}]},
