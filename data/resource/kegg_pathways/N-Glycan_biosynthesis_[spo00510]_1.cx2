{"attributeDeclarations":[{"nodes":{"KEGG_NODE_WIDTH":{"d":"string"},"KEGG_LINK":{"d":"string"},"NumChildren":{"d":"integer"},"KEGG_DEFINITION":{"d":"string"},"KEGG_NODE_HEIGHT":{"d":"string"},"KEGG_NODE_LABEL_COLOR":{"d":"string"},"KEGG_NODE_LABEL_LIST_FIRST":{"d":"string"},"KEGG_NODE_TYPE":{"d":"string"},"KEGG_NODE_LABEL":{"d":"string"},"NumDescendents":{"d":"integer"},"KEGG_NODE_REACTIONID":{"d":"string"},"name":{"d":"string"},"KEGG_NODE_LABEL_LIST":{"d":"list_of_string"},"KEGG_ID":{"d":"list_of_string"},"KEGG_NODE_Y":{"d":"string"},"KEGG_NODE_SHAPE":{"d":"string"},"KEGG_NODE_X":{"d":"string"},"selected":{"d":"boolean"},"KEGG_NODE_FILL_COLOR":{"d":"string"}},"networkAttributes":{"KEGG_PATHWAY_IMAGE":{"d":"string"},"KEGG_PATHWAY_ORG":{"d":"string"},"modules_id":{"d":"list_of_string"},"__Annotations":{"d":"list_of_string"},"KEGG_PATHWAY_ID":{"d":"string"},"classes":{"d":"list_of_string"},"description":{"d":"string"},"diseases":{"d":"list_of_string"},"diseases_id":{"d":"list_of_string"},"KEGG_PATHWAY_LINK":{"d":"string"},"modules":{"d":"list_of_string"},"shared name":{"d":"string"},"name":{"d":"string"},"selected":{"d":"boolean"}},"edges":{"shared name":{"d":"string"},"KEGG_RELATION_TYPE":{"d":"string"},"KEGG_REACTION_TYPE":{"d":"string"},"KEGG_EDGE_COLOR":{"d":"string"},"KEGG_EDGE_COLOR_BG":{"d":"string"},"shared interaction":{"d":"string"},"KEGG_REACTION_GENE":{"d":"string"},"name":{"d":"string"},"interaction":{"d":"string"},"KEGG_EDGE_SUBTYPES":{"d":"list_of_string"},"KEGG_EDGE_LABEL":{"d":"string"},"selected":{"d":"boolean"}}}]},
{"networkAttributes":[{"KEGG_PATHWAY_IMAGE":"https://www.kegg.jp/kegg/pathway/spo/spo00510.png","KEGG_PATHWAY_ORG":"spo","modules_id":[""],"KEGG_PATHWAY_ID":"path:spo00510","classes":["Metabolism","Glycan biosynthesis and metabolism"],"description":"N-glycans or asparagine-linked glycans are major constituents of glycoproteins in eukaryotes. N-glycans are covalently attached to asparagine with the consensus sequence of Asn-X-Ser/Thr by an N-glycosidic bond, GlcNAc b1- Asn. Biosynthesis of N-glycans begins on the cytoplasmic face of the ER membrane with the transferase reaction of UDP-GlcNAc and the lipid-like precursor P-Dol (dolichol phosphate) to generate GlcNAc a1- PP-Dol. After sequential addition of monosaccharides by ALG glycosyltransferases [MD:M00055], the N-glycan precursor is attached by the OST (oligosaccharyltransferase) complex to the polypeptide chain that is being synthesized and translocated through the ER membrane. The protein-bound N-glycan precursor is subsequently trimmed, extended, and modified in the ER and Golgi by a complex series of reactions catalyzed by membrane-bound glycosidases and glycosyltransferases. N-glycans thus synthesized are classified into three types: high-mannose type, complex type, and hybrid type. Defects in N-glycan biosynthesis lead to a variety of human diseases known as congenital disorders of glycosylation [DS:H00118 H00119].","diseases":[""],"diseases_id":[""],"KEGG_PATHWAY_LINK":"https://www.kegg.jp/kegg-bin/show_pathway?spo00510","modules":[""],"name":"N-Glycan biosynthesis [spo00510]_1"}]},
