{"attributeDeclarations":[{"nodes":{"KEGG_NODE_WIDTH":{"d":"string"},"KEGG_LINK":{"d":"string"},"KEGG_DEFINITION":{"d":"string"},"KEGG_NODE_HEIGHT":{"d":"string"},"KEGG_NODE_LABEL_COLOR":{"d":"string"},"KEGG_NODE_LABEL_LIST_FIRST":{"d":"string"},"KEGG_NODE_TYPE":{"d":"string"},"KEGG_NODE_LABEL":{"d":"string"},"KEGG_NODE_REACTIONID":{"d":"string"},"name":{"d":"string"},"KEGG_NODE_LABEL_LIST":{"d":"list_of_string"},"KEGG_ID":{"d":"list_of_string"},"KEGG_NODE_Y":{"d":"string"},"KEGG_NODE_SHAPE":{"d":"string"},"KEGG_NODE_X":{"d":"string"},"selected":{"d":"boolean"},"KEGG_NODE_FILL_COLOR":{"d":"string"}},"networkAttributes":{"KEGG_PATHWAY_IMAGE":{"d":"string"},"KEGG_PATHWAY_ORG":{"d":"string"},"modules_id":{"d":"list_of_string"},"__Annotations":{"d":"list_of_string"},"KEGG_PATHWAY_ID":{"d":"string"},"classes":{"d":"list_of_string"},"description":{"d":"string"},"diseases":{"d":"list_of_string"},"diseases_id":{"d":"list_of_string"},"KEGG_PATHWAY_LINK":{"d":"string"},"modules":{"d":"list_of_string"},"shared name":{"d":"string"},"name":{"d":"string"},"selected":{"d":"boolean"}},"edges":{"shared name":{"d":"string"},"KEGG_RELATION_TYPE":{"d":"string"},"KEGG_REACTION_TYPE":{"d":"string"},"KEGG_EDGE_COLOR":{"d":"string"},"KEGG_EDGE_COLOR_BG":{"d":"string"},"shared interaction":{"d":"string"},"KEGG_REACTION_GENE":{"d":"string"},"name":{"d":"string"},"interaction":{"d":"string"},"KEGG_EDGE_SUBTYPES":{"d":"list_of_string"},"KEGG_EDGE_LABEL":{"d":"string"},"selected":{"d":"boolean"}}}]},
{"networkAttributes":[{"KEGG_PATHWAY_IMAGE":"https://www.kegg.jp/kegg/pathway/spo/spo03008.png","KEGG_PATHWAY_ORG":"spo","modules_id":[""],"KEGG_PATHWAY_ID":"path:spo03008","classes":["Genetic Information Processing","Translation"],"description":"Ribosomes are the cellular factories responsible for making proteins. In eukaryotes, ribosome biogenesis involves the production and correct assembly of four rRNAs and about 80 ribosomal proteins. It requires hundreds of factors not present in the mature particle. In the absence of these proteins, ribosome biogenesis is stalled and cell growth is terminated even under optimal growth conditions. The primary pre-rRNA transcript is assembled into the 90S pre-ribosome, which contains both 40S and 60S assembly factors. Within this complex, the pre-rRNA is cleaved. pre-60S ribosomes are subjected to several sequential processing steps in the nucleoplasm involving numerous assembly intermediates before it is exported to the cytoplasm and matured into the 60S ribosomal subunit. The pre-40S ribosome is matured to the small ribosomal subunit in the cytoplasm by cleavage.","diseases":[""],"diseases_id":[""],"KEGG_PATHWAY_LINK":"https://www.kegg.jp/kegg-bin/show_pathway?spo03008","modules":[""],"name":"Ribosome biogenesis in eukaryotes [spo03008]_1"}]},
