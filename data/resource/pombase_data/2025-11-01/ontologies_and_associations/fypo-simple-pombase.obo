[Term]
id: FYPO:0007868
name: sensitive to actin polymerization inhibitor
def: "A phenotype observed in the vegetative growth phase of the life cycle in which cells show increased sensitivity to a substance that inhibits actin polymerization. Cells stop growing (and may die) at a concentration of an actin polymerization inhibitor that allows wild type cells to grow." [PomBase:mah]
synonym: "sensitive to actin cytoskeleton damaging agent" RELATED [PomBase:vw]
synonym: "sensitive to actin polymerisation inhibitor" EXACT [CHEBI:70728]
is_a: FYPO:0000127 ! increased sensitivity to chemical during vegetative growth
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2021-10-05T14:20:06Z" xsd:dateTime

[Term]
id: FYPO:0007869
name: abnormal protein localization to lateral cell cortex
def: "A cell phenotype in which the localization of a protein to the lateral cell cortex is abnormal." [PomBase:mah]
synonym: "abnormal protein localisation to lateral cell cortex" EXACT [PomBase:mah]
synonym: "abnormal protein localization to lateral cortex" EXACT [PomBase:mah]
is_a: FYPO:0001370 ! abnormal protein localization
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2021-10-05T14:25:42Z" xsd:dateTime

[Term]
id: FYPO:0007870
name: abolished protein localization to lateral cell cortex, with protein mislocalized to cytoplasm, during vegetative growth
def: "A cell phenotype observed in the vegetative growth phase of the life cycle in which the localization of a protein to the lateral cell cortex is abolished, and the protein is present in the cytoplasm instead." [PMID:34533984, PomBase:mah]
synonym: "abolished protein localisation to lateral cell cortex, with protein mislocalized to cytoplasm, during vegetative growth" EXACT [PomBase:mah]
synonym: "abolished protein localization to cell side, with protein mislocalized to cytoplasm, during vegetative growth" RELATED [PomBase:vw]
synonym: "abolished protein localization to lateral cell cortex, with protein mislocalized to cytoplasm, during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "abolished protein localization to lateral cortex, with protein mislocalized to cytoplasm, during vegetative growth" EXACT [PomBase:vw]
synonym: "protein localization to lateral cell cortex abolished, with protein mislocalized to cytoplasm, during vegetative growth" EXACT [PomBase:mah]
is_a: FYPO:0000928 ! abnormal protein localization to cell cortex during vegetative growth
is_a: FYPO:0007869 ! abnormal protein localization to lateral cell cortex
