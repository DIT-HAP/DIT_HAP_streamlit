property_value: http://purl.org/dc/elements/1.1/date "2021-03-10T15:49:06Z" xsd:dateTime

[Term]
id: FYPO:0007677
name: abnormal sterol distribution
def: "A localization phenotype observed in the vegetative growth phase of the life cycle in which the distribution of sterols in cellular membranes is abnormal." [PMID:32320462, PomBase:mah]
is_a: FYPO:0006545 ! abnormal membrane lipid distribution
