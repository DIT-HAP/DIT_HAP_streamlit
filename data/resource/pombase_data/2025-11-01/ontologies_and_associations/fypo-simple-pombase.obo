property_value: http://purl.org/dc/elements/1.1/date "2020-07-01T14:12:09Z" xsd:dateTime

[Term]
id: FYPO:0007427
name: abnormal old mitotic spindle pole body insertion into nuclear envelope, with spindle pole body in nucleoplasm
def: "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which the insertion of the old spindle pole body (SPB) into the nuclear envelope is abnormal, and the SPB enters the nucleus. The old SPB may be transiently inserted into the nuclear envelope but does not remain in place as normal." [PMID:19487457, PomBase:mah, PomBase:vw]
synonym: "abnormal establishment of old mitotic spindle pole body localization to nuclear envelope, with spindle pole body in nucleoplasm" EXACT [PomBase:mah]
synonym: "abnormal old mitotic SPB insertion into nuclear envelope, with spindle pole body in nucleoplasm" EXACT [PomBase:mah]
synonym: "abnormal old mitotic spindle pole body insertion into nuclear envelope, with spindle pole body in nucleoplasm during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "abnormal old mitotic spindle pole body insertion into nuclear envelope, with spindle pole body in nucleoplasm during vegetative growth" EXACT [PomBase:mah]
is_a: FYPO:0003568 ! abnormal mitotic spindle pole body insertion into nuclear envelope, with spindle pole body in nucleoplasm
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2020-07-01T14:17:59Z" xsd:dateTime

[Term]
id: FYPO:0007428
name: delayed onset of mitotic spindle microtubule nucleation from old spindle pole body
def: "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which the nucleation of microtubules from the old mitotic spindle pole body begins later than normal." [PMID:19487457, PomBase:mah]
