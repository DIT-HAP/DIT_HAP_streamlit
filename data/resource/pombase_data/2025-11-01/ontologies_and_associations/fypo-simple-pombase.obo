synonym: "inviable cell with cytokinesis without nuclear division" RELATED [PomBase:al, PomBase:vw]
synonym: "inviable cell with premature septation" RELATED [PomBase:al, PomBase:vw]
synonym: "inviable cell with septation in the absence of nuclear division" RELATED [PomBase:al, PomBase:vw]
synonym: "inviable cell with septation independent of mitosis" RELATED [PomBase:al, PomBase:vw]
synonym: "inviable cell with septation without nuclear division" RELATED [PomBase:al, PomBase:vw]
synonym: "inviable septated mononucleate cell" EXACT [PomBase:vw]
synonym: "inviable septated mononucleate cell during vegetative growth" EXACT [PomBase:mah]
synonym: "inviable septated mononucleate vegetative cell during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "inviable septated mononucleate vegetative cell with mislocalized nucleus" EXACT [PomBase:mah]
synonym: "lethal; septated mononucleate vegetative cell" EXACT [PomBase:mah]
synonym: "septation in the absence of nuclear division" RELATED [PomBase:al, PomBase:vw]
synonym: "septation independent of mitosis" RELATED [PomBase:al, PomBase:vw]
synonym: "septation without nuclear division" RELATED [PomBase:al, PomBase:vw]
