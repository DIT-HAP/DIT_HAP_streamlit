property_value: http://purl.org/dc/elements/1.1/date "2020-06-09T12:38:25Z" xsd:dateTime

[Term]
id: FYPO:0007385
name: increased duration of protein-protein interaction
def: "A molecular function phenotype in which the binding of one protein to another occurs for a longer time than normal. The relevant proteins may include the one encoded by the mutated gene, or may both be encoded by different genes." [PMID:28366743, PomBase:mah]
synonym: "increased duration of protein binding" EXACT [PomBase:mah]
is_a: FYPO:0000704 ! abnormal protein-protein interaction
