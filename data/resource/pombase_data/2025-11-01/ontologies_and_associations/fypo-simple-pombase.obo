synonym: "lethal; elongated vegetative cell with mitotic cell cycle arrest in interphase during cellular response to UV" EXACT [PomBase:mah]
synonym: "mitotic interphase arrested elongated inviable vegetative cell during cellular response to UV" EXACT [PomBase:mah]
is_obsolete: true
