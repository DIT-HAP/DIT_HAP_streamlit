property_value: http://purl.org/dc/elements/1.1/date "2021-06-03T14:27:36Z" xsd:dateTime

[Term]
id: FYPO:0007783
name: abolished geometry scaling
def: "A cell phenotype in which cellular geometry scaling, by which cells normally maintain a fairly constant length:diameter (width) ratio upon changes in cell volume, does not occur." [PMID:30664646, PomBase:mah]
synonym: "abolished cell geometry scaling" EXACT [PomBase:mah]
synonym: "abolished cellular geometry scaling" EXACT [PomBase:mah]
synonym: "abolished geometry scaling during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "abolished geometry scaling during vegetative growth" EXACT [PomBase:mah]
synonym: "geometry scaling abolished" EXACT [PomBase:mah]
