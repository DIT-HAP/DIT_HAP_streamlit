[Term]
id: FYPO:0009102
name: interphase microtubules present in decreased numbers
def: "A physical cellular phenotype observed in the vegetative growth phase of the life cycle in which cells contain less cytoplasmic microtubules than normal during interphase of the mitotic cell cycle." []
synonym: "decreased number of interphase microtubules" EXACT []
synonym: "fewer microtubules present during mitotic interphase" EXACT []
is_a: FYPO:0003430 ! microtubules present in decreased numbers
property_value: http://purl.org/dc/elements/1.1/creator "PomBase:mlr" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-06-29T10:32:36Z" xsd:dateTime

[Term]
id: FYPO:0009103
name: increased actomyosin contractile ring recoil distance after ring ablation
def: "A cell phenotype in which the recoil distance of the cytokynetic ring after ring ablation is increased with respect to wild type. Experimentally, a localised cut or ablation is typically achieved using a laser. This distance, in combination with the timing of recoil are used to compute effective stiffness and drag of the ring components. See PMID:36980258." []
synonym: "increased cytokinetic ring recoil distance after laser ablation" BROAD []
xref: PMID:36980258
is_a: FYPO:0004736 ! abnormal actomyosin contractile ring
property_value: http://purl.org/dc/elements/1.1/creator "PomBase:mlr" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-06-29T10:36:53Z" xsd:dateTime

[Term]
id: FYPO:0009104
name: increased actomyosin contractile ring recoil time after ring ablation
def: "A cell phenotype in which the recoil time of the cytokynetic ring after ring ablation is increased with respect to wild type. Experimentally, a localised cut or ablation is typically achieved using a laser. The recoil time is the time it takes the recoil to stop after laser ablation. This timing, in combination with the recoil distance are used to compute effective stiffness and drag of the ring components. See PMID:36980258." []
synonym: "increased cytokinetic ring recoil distance after laser ablation" BROAD []
xref: PMID:36980258
is_a: FYPO:0004736 ! abnormal actomyosin contractile ring
property_value: http://purl.org/dc/elements/1.1/creator "PomBase:mlr" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-06-29T10:38:29Z" xsd:dateTime

[Term]
id: FYPO:0009105
name: mislocalized nucleus during mitotic telophase
def: "A physical cellular phenotype observed in the vegetative growth phase of the life cycle in which the divided nuclei are mislocalized during telophase of the mitotic cell cycle." [PMID:37099380]
synonym: "abnormal nuclei location during mitotic telophase" EXACT []
synonym: "abnormal nucleus location during mitotic telophase" EXACT []
synonym: "abnormal nucleus position during mitotic telophase" EXACT []
synonym: "abnormal nucleus positioning during mitotic telophase" EXACT []
synonym: "mislocalised nuclei during mitotic telophase" EXACT []
synonym: "mislocalised nucleus during mitotic telophase" EXACT []
is_a: FYPO:0002071 ! mislocalized nucleus during vegetative growth
property_value: http://purl.org/dc/elements/1.1/creator "PomBase:mlr" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-07-03T10:13:41Z" xsd:dateTime

[Term]
id: FYPO:0009106
name: nucleus mislocalized towards cell equator during mitotic telophase
def: "A physical cellular phenotype observed in the vegetative growth phase of the life cycle in which the divided nuclei are located closer to the cell equator during telophase of the mitotic cell cycle when compared to wild-type cells." [PMID:37099380]
synonym: "nuclear displaced towards cell equator during mitotic telophase" EXACT []
synonym: "nuclear displaced towards cytokinetic ring during mitotic telophase" EXACT []
synonym: "nuclear displacement towards cell equator during mitotic telophase" EXACT []
synonym: "nuclear displacement towards cytokinetic ring during mitotic telophase" EXACT []
is_a: FYPO:0009105 ! mislocalized nucleus during mitotic telophase
property_value: http://purl.org/dc/elements/1.1/creator "PomBase:mlr" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-07-03T10:21:38Z" xsd:dateTime

[Term]
id: FYPO:0009107
name: increased nuclear movement velocity during mitotic telophase
def: "A cellular process phenotype observed in mitotic interphase in which the microtubule-driven movement of daughter nuclei away from the cell tips after mitotic spindle dissambly occurs at a faster speed than normal during telophase." [PMID:37099380]
synonym: "increased nuclear displacement speed during telophase" EXACT []
synonym: "increased nuclear displacement velocity during telophase" EXACT []
synonym: "increased nuclear movement speed during telophase" EXACT []
is_a: FYPO:0005461 ! abnormal microtubule-based movement during vegetative growth
property_value: http://purl.org/dc/elements/1.1/creator "PomBase:mlr" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-07-03T10:39:37Z" xsd:dateTime

[Term]
id: FYPO:0009108
name: abnormal spindle pole body orientation during mitotic telophase
def: "A physical cellular phenotype observed in the vegetative growth phase of the life cycle in which the spindle pole bodies (SPBs) of daughter nuclei are misoriented during mitotic telophase. Normally, SPBs face the cell tips at the end of anaphase when the spindle disassembles, but as microtubules are nucleated from SPBs and telophase nuclear positioning proceeds, the SPBs tend to face the cell equator." [PMID:37099380]
synonym: "abnormal spindle pole body angle during mitotic telophase" EXACT []
synonym: "abnormal spindle pole body positioning within the nucleus during mitotic telophase" EXACT []
synonym: "spindle pole body facing cell tips during mitotic telophase" RELATED []
is_a: FYPO:0000136 ! cellular physical quality phenotype
property_value: http://purl.org/dc/elements/1.1/creator "PomBase:mlr" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-07-03T10:51:11Z" xsd:dateTime

[Term]
id: FYPO:0009109
name: decreased vegetative cell population growth after short incubation in hydroxyurea
def: "A cell growth phenotype in which cell population growth is decreased relative to normal after short incubation in hydroxyurea." []
synonym: "decreased vegetative cell population growth after acute hydroxyurea treatment" EXACT []
xref: PMID:37200372
is_a: FYPO:0001355 ! decreased vegetative cell population growth
is_a: FYPO:0002683 ! increased sensitivity to chemical
property_value: http://purl.org/dc/elements/1.1/creator "PomBase:mlr" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-07-10T09:12:12Z" xsd:dateTime

[Term]
id: FYPO:0009110
name: normal vegetative cell population growth after short incubation in hydroxyurea
def: "A cell growth phenotype in which cell population growth is normal after short incubation in hydroxyurea." []
synonym: "normal vegetative cell population growth after acute hydroxyurea treatment" EXACT []
xref: PMID:37200372
is_a: FYPO:0001357 ! normal vegetative cell population growth
property_value: http://purl.org/dc/elements/1.1/creator "PomBase:mlr" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-07-10T09:26:07Z" xsd:dateTime

[Term]
id: FYPO:0009111
name: increased flocculation during vegetative growth
def: "A vegetative cell population phenotype that reflects increased occurrence of flocculation. Flocculation is the non-sexual aggregation of single cells." [PMID:35924983]
is_a: FYPO:0000155 ! increased flocculation
property_value: http://purl.org/dc/elements/1.1/creator "PomBase:mlr" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-07-28T07:40:58Z" xsd:dateTime

[Term]
id: FYPO:0009112
name: abolished flocculation during vegetative growth
def: "A cell adhesion phenotype observed in the vegetative growth phase of the life cycle in which flocculation does not occur in conditions where wild-type cells floculate. Flocculation is the non-sexual aggregation of cells." [PMID:35924983]
is_a: FYPO:0000009 ! abnormal cell adhesion during vegetative growth
property_value: http://purl.org/dc/elements/1.1/creator "PomBase:mlr" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-07-28T07:46:49Z" xsd:dateTime

[Term]
id: FYPO:0009113
name: abolished protein localization to mitotic spindle polar microtubules during anaphase B
def: "A cell phenotype observed in the vegetative growth phase of the life cycle in which the localization of a protein to the mitotic spindle polar microtubules during anaphase B does not occur." [PMID:34080538]
synonym: "abolished protein localisation to interpolar microtubules during mitotic anaphase B" EXACT []
synonym: "abolished protein localisation to mitotic spindle polar microtubules during anaphase B" EXACT []
synonym: "abolished protein localization to interpolar microtubules during mitotic anaphase B" EXACT []
is_a: FYPO:0004754 ! abolished protein localization to mitotic spindle during mitosis
property_value: http://purl.org/dc/elements/1.1/creator "PomBase:mlr" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-07-28T08:09:39Z" xsd:dateTime

[Term]
id: FYPO:0009114
name: transient monopolar mitotic spindle
def: "A physical cellular phenotype in which the mitotic spindle remains monopolar when formed, with microtubules emanating from only one pole, for longer than wild-type, but eventually reaches bipolarity." [PMID:25057016]
synonym: "monopolar mitotic spindle that eventually reaches bipolarity" EXACT []
synonym: "temporary monopolar mitotic spindle" EXACT []
is_a: FYPO:0000276 ! monopolar mitotic spindle
property_value: http://purl.org/dc/elements/1.1/creator "PomBase:mlr" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-07-28T08:20:20Z" xsd:dateTime

[Typedef]
id: during
name: during
xref: GOREL:0000002
property_value: usage "Identifies a process, cell cycle stage or life stage during which a phenotype is observed or relevant." xsd:string

[Typedef]
id: exists_during
name: exists_during
xref: GOREL:0000032
property_value: usage "Identifies a process, cell cycle stage or life stage during which a phenotype that affects a continuant, such as a cellular component or the level of a substance, is observed or relevant." xsd:string

[Typedef]
id: happens_during
name: happens_during
xref: GOREL:0000001
property_value: usage "Identifies a process, cell cycle stage or life stage during which a phenotype that affects an occurrent, i.e. a biological process or molecular function, is observed or relevant." xsd:string

[Typedef]
id: has_output
name: has_output
def: "p has output c if either: p has direct output c or p has output input c. Implies that if p happens, c always ensues." [GOC:curators]
property_value: usage "Def comes from gorel file. Used in FYPO where one phenotype (p) always results in an additional phenotype (c) as a consequence. There may be other ways to get phenotype (c)." xsd:string

[Typedef]
id: has_part
name: has_part
xref: BFO:0000051
property_value: usage "Used in FYPO to link phenotypes that are collections of features to phenotypes representing the features." xsd:string
is_transitive: true

[Typedef]
id: inheres_in
name: inheres_in
xref: RO:0000052
property_value: usage "Used in FYPO as described in PATO best practices; identifies an entity that displays a quality in an entity-quality logical definition. Used only in logical definitions (aka xps)." xsd:string

[Typedef]
id: inheres_in_part_of
name: inheres in part of
xref: RO:0002314
property_value: usage "Used in FYPO as described in MP/HP logical definition best practices for processes, and in an analogous manner for cell/cell part structure; identifies an entity that displays a quality in an entity-quality logical definition. Used only in logical definitions (aka xps)." xsd:string

[Typedef]
id: located_in
name: located in
xref: RO:0001025
property_value: usage "Used in FYPO to indicate where a physical quality phenotype is observed." xsd:string

[Typedef]
id: occurs_at
name: occurs_at
xref: GOREL:0000501
property_value: usage "This relation is not constrained with respect to whether the place where an event occurs completely surrounds, or is adjacent to, the location indicated. Example: chromatin silencing at centromere unfolds_around centromere : Repression of transcription of centromeric DNA by the formation of heterochromatin. Used in FYPO to identify a position where a phenotype is observed or relevant, usually a DNA or RNA sequence feature specified by a SO ID." xsd:string

[Typedef]
id: occurs_in
name: occurs in
xref: BFO:0000066
property_value: usage "Used in FYPO to identify a location, usually a cellular component or cell type, within which a phenotype is observed or relevant." xsd:string

[Typedef]
id: output_of
name: output_of
synonym: "formation results from" EXACT [PomBase:mah]
property_value: usage "Inverse of has_output. Relation between a structure and a process that forms it, or between one process and a preceding process; A output_of B used where B has_output A isn't always true. Implies that process B is the only way to get output. Used in FYPO where one phenotype (c) always results when another phenotype (p) is present. Phenotype (p) may have other consequences in addition to phenotype (c)." xsd:string

[Typedef]
id: part_of
name: part_of
xref: BFO:0000050
property_value: usage "Used in FYPO to identify phenotypes that are always observed in the context of another, usually larger-scale, phenotype." xsd:string

[Typedef]
id: preceded_by
name: preceded_by
property_value: usage "Used in FYPO when a phenotype is observed after another event, usually a GO biological process, has ended, and where there isn't a suitable process to use with a during relation." xsd:string

[Typedef]
id: precedes
name: precedes
property_value: usage "Used in FYPO when a phenotype is observed before another event, usually a GO biological process, begins, and where there isn't a suitable process to use with a during relation." xsd:string

[Typedef]
id: qualifier
name: qualifier
xref: RO:0002573
property_value: usage "Used in FYPO as described in PATO best practices; placeholder relation to indicate normality/abnormality." xsd:string

[Typedef]
id: towards
name: towards
xref: RO:0002503
property_value: usage "Relation binding a relational quality or disposition to the relevant type of entity. Used in FYPO as described in PATO best practices; identifies abolished GO processes; identifies substances affected by phenotypes." xsd:string

