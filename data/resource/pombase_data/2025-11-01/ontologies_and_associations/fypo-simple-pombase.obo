created_by: midori
creation_date: 2014-08-12T14:48:51Z

[Term]
id: FYPO:0003679
name: sensitive to epirubicin
def: "A phenotype observed in the vegetative growth phase of the life cycle in which cells show increased sensitivity to epirubicin. Cells stop growing (and may die) at a concentration of epirubicin that allows wild type cells to grow." [PomBase:mah]
synonym: "hypersensitive to epirubicin" EXACT [PomBase:mah]
synonym: "sensitive to 4'-epidoxorubicin" EXACT [CHEBI:47898]
