property_value: http://purl.org/dc/elements/1.1/date "2020-11-25T15:26:30Z" xsd:dateTime

[Term]
id: FYPO:0007537
name: increased replication slippage during replication fork processing
def: "A cell phenotype observed in the vegetative growth phase of the life cycle in which the increase in small deletions or duplications (\"replication slippage\") that normally results from processing arrested replication forks is enhanced." [PMID:33159083, PomBase:mah]
synonym: "increased replication slippage during replication fork processing during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "increased replication slippage during replication fork processing during vegetative growth" EXACT [PomBase:mah]
