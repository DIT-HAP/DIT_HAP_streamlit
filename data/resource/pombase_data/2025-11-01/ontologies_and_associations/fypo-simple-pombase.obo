property_value: http://purl.org/dc/elements/1.1/date "2021-01-27T12:54:42Z" xsd:dateTime

[Term]
id: FYPO:0007618
name: delayed onset of protein export from nucleus
def: "A transport phenotype observed in the vegetative growth phase of the life cycle in which the export of protein from the nucleus begins later than normal. Export of all proteins or a specific protein may be affected." [PomBase:mah]
comment: We recommend noting which protein(s) were used in the assay when annotating to this term.
synonym: "delayed onset of protein export from nucleus during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "delayed onset of protein export from nucleus during vegetative growth" EXACT [PomBase:mah]
