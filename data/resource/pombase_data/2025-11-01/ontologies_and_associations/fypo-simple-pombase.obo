property_value: http://purl.org/dc/elements/1.1/date "2020-11-25T11:52:32Z" xsd:dateTime

[Term]
id: FYPO:0007530
name: abolished histone H3-K9 dimethylation at heterochromatin island at meiotic gene during vegetative growth
def: "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which dimethylation of lysine at position 9 of histone H3 does not occur at heterochromatin islands near genes that are normally expressed during the meiotic cell cycle." [PMID:22144463, PomBase:mah]
synonym: "abolished histone H3 K9 dimethylation at heterochromatin island at meiotic gene during vegetative growth" EXACT [PomBase:mah]
synonym: "abolished histone H3-K9 dimethylation at heterochromatin island at meiosis gene during vegetative growth" EXACT [PomBase:mah]
synonym: "abolished histone H3-K9 dimethylation at heterochromatin island at meiotic gene during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "abolished histone H3K9 dimethylation at heterochromatin island at meiotic gene during vegetative growth" EXACT [PomBase:mah]
synonym: "abolished histone H3K9me2 at heterochromatin island at meiotic gene during vegetative growth" EXACT [PomBase:mah]
synonym: "histone H3-K9 dimethylation abolished at heterochromatin island at meiotic gene during vegetative growth" EXACT [PomBase:mah]
