synonym: "slow cell growth on glutamate nitrogen source" NARROW [PomBase:mlr]
is_a: FYPO:0001355 ! decreased vegetative cell population growth
created_by: PomBase:mlr
creation_date: 2023-02-17T15:43:28Z

[Term]
id: FYPO:0009054
name: increased viabilitiy in stationary phase upon glucose starvation
def: "A cell population phenotype in which a higher than normal proportion of cells in the population remains viable after entering stationary phase, when subjected to glucose starvation." []
is_a: FYPO:0001309 ! increased viability in stationary phase
property_value: http://purl.org/dc/elements/1.1/creator "PomBase:mlr" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-02-23T11:45:24Z" xsd:dateTime

[Term]
id: FYPO:0009055
name: resistance to ethyl methanesulfonate
def: "An increased chemical resistance phenotype observed in the vegetative growth phase of the life cycle in which cells grow in the presence of a higher concentration of ethyl methanesulfonate than normal." [PomBase:mlr]
synonym: "resistance to ethyl methanesulfonate during mitotic cell cycle" RELATED [PomBase:mlr]
synonym: "resistance to ethyl methanesulfonate during vegetative growth" EXACT [PomBase:mlr]
