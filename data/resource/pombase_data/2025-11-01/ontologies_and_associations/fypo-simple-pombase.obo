property_value: http://purl.org/dc/elements/1.1/date "2021-10-05T15:09:07Z" xsd:dateTime

[Term]
id: FYPO:0007877
name: normal regulation of translation in response to chemical
def: "A gene expression phenotype observed in the vegetative growth phase of the life cycle in which regulation of translation in response to a chemical stimulus is normal (i.e. indistinguishable from wild type)." [PMID:34296454, PomBase:mah]
synonym: "normal regulation of translation in response to chemical during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "normal regulation of translation in response to chemical during vegetative growth" EXACT [PomBase:mah]
synonym: "normal regulation of translation in response to chemical stimulus" EXACT [PomBase:mah]
synonym: "normal translational regulation in response to chemical" EXACT [PomBase:mah]
