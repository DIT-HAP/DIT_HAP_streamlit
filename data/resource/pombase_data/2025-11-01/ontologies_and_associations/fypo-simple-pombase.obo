property_value: http://purl.org/dc/elements/1.1/date "2020-09-07T14:49:38Z" xsd:dateTime

[Term]
id: FYPO:0007458
name: abolished nuclear pore localization to mitotic nuclear bridge
def: "A localization phenotype observed in the vegetative growth phase of the life cycle in which nuclear pore localization to the portion of the nuclear envelope enclosing the mitotic nuclear bridge does not occur. The nuclear bridge is a narrow constricted region of the nucleus that forms around the mitotic spindle during anaphase. Normally, nuclear pores that lack baskets are found in the midzone of the nuclear bridge." [GO:0140510, PMID:32848252, PomBase:mah]
synonym: "abolished NPC localization to mitotic nuclear bridge" EXACT [PomBase:mah]
synonym: "abolished nuclear pore complex localization to mitotic nuclear bridge" EXACT [PomBase:mah]
synonym: "abolished nuclear pore distribution to mitotic nuclear bridge" EXACT [GO:0051664]
synonym: "abolished nuclear pore localisation to mitotic nuclear bridge" EXACT [PomBase:mah]
synonym: "abolished nuclear pore localization in nuclear envelope at mitotic nuclear bridge" EXACT [PomBase:mah]
synonym: "abolished nuclear pore localization to mitotic nuclear bridge during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "abolished nuclear pore localization to mitotic nuclear bridge during vegetative growth" EXACT [PomBase:mah]
synonym: "abolished nuclear pore localization to mitotic nuclear bridge membrane domain" EXACT [PomBase:mah]
is_a: FYPO:0003783 ! abnormal nuclear pore localization during mitosis
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2020-09-07T15:06:33Z" xsd:dateTime

[Term]
id: FYPO:0007459
name: abnormal nuclear envelope morphology at mitotic nuclear bridge
def: "A physical cellular phenotype observed in the vegetative growth phase of the life cycle in which the size, shape, or structure of the portion of the nuclear envelope enclosing the mitotic nuclear bridge is abnormal. The nuclear bridge is a narrow constricted region of the nucleus that forms around the mitotic spindle during anaphase." [GO:0140510, PMID:32848252, PomBase:mah]
synonym: "abnormal nuclear envelope morphology at mitotic nuclear bridge during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "abnormal nuclear envelope morphology at mitotic nuclear bridge during vegetative growth" EXACT [PomBase:mah]
is_a: FYPO:0003779 ! abnormal nuclear envelope morphology during mitosis
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2020-09-07T15:17:01Z" xsd:dateTime

[Term]
id: FYPO:0007460
name: abnormal nuclear envelope morphology at mitotic nuclear bridge midzone
def: "A physical cellular phenotype observed in the vegetative growth phase of the life cycle in which the size, shape, or structure of the portion of the nuclear envelope enclosing the midzone of the mitotic nuclear bridge is abnormal. The nuclear bridge is a narrow constricted region of the nucleus that forms around the mitotic spindle during anaphase." [GO:0140510, PMID:32848252, PomBase:mah]
synonym: "abnormal nuclear envelope morphology at mitotic nuclear bridge midzone during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "abnormal nuclear envelope morphology at mitotic nuclear bridge midzone during vegetative growth" EXACT [PomBase:mah]
