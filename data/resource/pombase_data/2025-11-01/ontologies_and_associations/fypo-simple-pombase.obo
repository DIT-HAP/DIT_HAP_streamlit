synonym: "inviable elongated cell with mitotic G2/M transition delay and M phase arrest" EXACT [PomBase:vw]
synonym: "lethal; elongated cell with mitotic G2/M transition delay and cell cycle arrest in M phase" EXACT [PomBase:mah]
synonym: "long inviable cell with mitotic G2/M transition delay and cell cycle arrest in M phase" EXACT [PomBase:vw]
