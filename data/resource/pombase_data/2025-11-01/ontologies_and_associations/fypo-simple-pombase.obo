synonym: "meiotic cell cycle in presence of nutrients" EXACT [PomBase:mah]
synonym: "meiotic cell cycle without starvation" EXACT [PomBase:mah]
synonym: "sporulation in presence of nutrients" RELATED [PomBase:mah]
is_a: FYPO:0000052 ! abnormal meiotic cell cycle
created_by: midori
creation_date: 2017-07-12T11:14:21Z

[Term]
id: FYPO:0006108
