synonym: "decreased RNA level during exit from mitosis during mitotic cell cycle" EXACT [PomBase:mah]
synonym: "decreased RNA level during exit from mitosis during vegetative growth" EXACT [PomBase:mah]
synonym: "decreased RNA level during mitotic exit" EXACT [GO:0010458]
