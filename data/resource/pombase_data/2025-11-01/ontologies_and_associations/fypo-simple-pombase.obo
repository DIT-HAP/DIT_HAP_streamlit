synonym: "increased mRNA transcript level during vegetative growth" NARROW [PomBase:vw]
synonym: "increased RNA accumulation during vegetative growth" RELATED [PomBase:mah]
synonym: "increased RNA level during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "increased transcript level during vegetative growth" EXACT [PomBase:vw]
synonym: "RNA accumulation during vegetative growth" RELATED [PomBase:mah]
synonym: "RNA accumulation: increased during vegetative growth" RELATED [SGD:phenotype_annotation]
