synonym: "apoptosis: decreased" RELATED [SGD:phenotype_annotation]
synonym: "decreased apoptosis" EXACT [PomBase:mah]
synonym: "decreased apoptotic frequency" EXACT [PomBase:mah]
synonym: "reduced frequency of apoptosis" EXACT [PomBase:mah]
is_a: FYPO:0000003 ! cell population phenotype
