property_value: http://purl.org/dc/elements/1.1/date "2021-03-16T14:35:26Z" xsd:dateTime

[Term]
id: FYPO:0007686
name: increased number of nuclear exosome foci
def: "A cell phenotype in which the cell contains more nuclear exosome foci than normal." [PMID:33574613, PomBase:mah]
synonym: "increased number of Mmi1 foci" EXACT [PomBase:mah]
synonym: "increased number of Mmi1 nuclear foci" EXACT [GO:1990251]
