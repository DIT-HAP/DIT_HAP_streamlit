property_value: http://purl.org/dc/elements/1.1/date "2021-11-03T13:54:31Z" xsd:dateTime

[Term]
id: FYPO:0007879
name: abolished protein degradation during cellular response to methyl methanesulfonate
def: "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which protein degradation does not occur during a cellular response to methyl methanesulfonate. Protein degradation, also known as protein catabolism, is any metabolic process that results in the destruction of the native, active configuration of a protein, with or without the hydrolysis of peptide bonds." [GO:0030163, PMID:34608864, PomBase:mah]
synonym: "abolished protein breakdown during cellular response to methyl methanesulfonate" EXACT [GO:0030163, PomBase:mah]
