property_value: http://purl.org/dc/elements/1.1/date "2021-11-03T14:23:55Z" xsd:dateTime

[Term]
id: FYPO:0007882
name: normal protein kinase activity during cellular response to methyl methanesulfonate
def: "A molecular function phenotype in which the observed rate of a protein kinase activity is normal (i.e. indistinguishable from wild type) during a cellular response to methyl methanesulfonate." [PMID:34608864, PomBase:mah]
synonym: "normal protein kinase activity during cellular response to MMS" EXACT [PomBase:mah]
is_a: FYPO:0003075 ! normal protein kinase activity
