property_value: http://purl.org/dc/elements/1.1/date "2021-03-09T13:12:49Z" xsd:dateTime

[Term]
id: FYPO:0007669
name: viable swollen vegetative cell with complete DNA rereplication
def: "A cell phenotype observed in the vegetative growth phase of the life cycle in which a cell is viable, has a larger volume than normal, and undergoes one or more rounds of rereplication of the entire genome. In a swollen cell, both length and diameter may be greater than normal, although the cell is only considered elongated if the length:diameter ratio is also greater than normal." [PMID:8121488, PomBase:mah]
synonym: "viable enlarged vegetative cell with complete DNA rereplication" RELATED [PomBase:mah]
synonym: "viable large vegetative cell with complete DNA rereplication" RELATED [PomBase:vw]
synonym: "viable swollen cell with complete DNA rereplication during vegetative growth" EXACT [PomBase:mah]
synonym: "viable swollen vegetative cell with abnormal negative regulation of mitotic DNA replication initiation resulting in complete rereplication" EXACT [PomBase:mah]
synonym: "viable swollen vegetative cell with complete DNA rereplication during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "viable swollen vegetative cell with increased ploidy" EXACT [PomBase:vw]
synonym: "viable vegetative cell with increased cell size and complete DNA rereplication" RELATED [PomBase:vw]
synonym: "viable vegetative cell with increased cell volume and complete DNA rereplication" EXACT [PomBase:mah]
is_a: FYPO:0000216 ! abnormal negative regulation of mitotic DNA replication initiation
is_a: FYPO:0002377 ! viable swollen vegetative cell
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2021-03-09T13:27:55Z" xsd:dateTime

[Term]
id: FYPO:0007670
name: inviable mononucleate monoseptate vegetative cell with anucleate compartment and normal cell length
def: "A cell morphology phenotype observed in the vegetative growth phase of the life cycle in which a cell is inviable, is normal length, and has one nucleus and one septum. The septum divides the cell into two compartments, one of which contains the nucleus." [PMID:9862966, PomBase:mah]
synonym: "inviable mononucleate monoseptate cell with anucleate compartment and normal cell length during vegetative growth" EXACT [PomBase:mah]
synonym: "inviable mononucleate monoseptate vegetative cell with normal cell length" EXACT [PomBase:mah]
synonym: "inviable mononucleate monoseptate vegetative cell with normal cell length during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "inviable with septation in the absence of nuclear division; normal cell length" RELATED [PomBase:al, PomBase:vw]
synonym: "inviable with septation independent of mitosis, normal cell length" RELATED [PomBase:al, PomBase:vw]
synonym: "inviable with septation without nuclear division; normal cell length" RELATED [PomBase:al, PomBase:vw]
synonym: "lethal; mononucleate monoseptate vegetative cell with normal cell length" EXACT [PomBase:mah]
is_a: FYPO:0002303 ! inviable mononucleate monoseptate vegetative cell with anucleate compartment
is_a: FYPO:0003503 ! normal vegetative cell length
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2021-03-09T14:07:35Z" xsd:dateTime

[Term]
id: FYPO:0007671
name: normal transcription scaling
def: "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which the coordination of transcription rates to scale linearly with cell size is normal (i.e. indistinguishable from wild type). Transcriptional scaling maintains biomolecule concentrations as cells grow and divide. Total RNA or a specific RNA may be measured." [PMID:32059768, PomBase:mah]
synonym: "normal linear transcription scaling with cell size" EXACT [PomBase:mah]
synonym: "normal transcription scaling during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "normal transcription scaling during vegetative growth" EXACT [PomBase:mah]
synonym: "normal transcription scaling with cell size" EXACT [PomBase:mah]
is_a: FYPO:0001319 ! normal cellular process during vegetative growth
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2021-03-09T15:14:04Z" xsd:dateTime

[Term]
id: FYPO:0007672
name: transcription scaling with nuclear size decoupled from cell size
def: "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which the rate of transcription scales linearly with nuclear size instead of total cell size. Total RNA or a specific RNA may be affected." [PMID:32059768, PomBase:mah]
synonym: "abnormal transcription scaling with nuclear size" EXACT [PomBase:mah]
synonym: "linear transcription scaling with nuclear size decoupled from cell size" EXACT [PomBase:mah]
synonym: "transcription scaling with nuclear size decoupled from cell size during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "transcription scaling with nuclear size decoupled from cell size during vegetative growth" EXACT [PomBase:mah]
is_a: FYPO:0001362 ! abnormal cellular process during vegetative growth
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2021-03-09T15:15:05Z" xsd:dateTime

[Term]
id: FYPO:0007673
name: abolished invertase activity
def: "A molecular function phenotype in which invertase activity (beta-fructofuranosidase activity) is absent." [PomBase:mah]
synonym: "abolished beta-fructofuranosidase activity" EXACT [GO:0004564]
synonym: "invertase activity abolished" EXACT [GO:0004564]
is_a: FYPO:0005741 ! abnormal invertase activity
