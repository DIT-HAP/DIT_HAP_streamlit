property_value: http://purl.org/dc/elements/1.1/date "2020-11-25T11:18:23Z" xsd:dateTime

[Term]
id: FYPO:0007528
name: normal membrane lipid binding
def: "A molecular function phenotype in which occurrence of binding to a lipid in a membrane by a gene product (usually a protein) in a mutant is normal (i.e. indistinguishable from wild type)." [PMID:33172987, PomBase:mah]
synonym: "normal binding to lipid in membrane" EXACT [PomBase:mah]
is_a: FYPO:0006942 ! normal lipid binding
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2020-11-25T11:38:04Z" xsd:dateTime

[Term]
id: FYPO:0007529
name: normal histone H3-K9 dimethylation at heterochromatin island during vegetative growth
def: "A cellular process phenotype observed in the vegetative growth phase of the life cycle in which the dimethylation of lysine at position 9 of histone H3 at heterochromatin islands is normal (i.e. indistinguishable from wild type)." [PMID:22144463, PomBase:mah]
synonym: "normal histone H3 K9 dimethylation at heterochromatin island during vegetative growth" EXACT [PomBase:mah]
synonym: "normal histone H3-K9 dimethylation at heterochromatin island during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "normal histone H3K9 dimethylation at heterochromatin island during vegetative growth" EXACT [PomBase:mah]
synonym: "normal histone H3K9me2 at heterochromatin island during vegetative growth" EXACT [PomBase:mah]
is_a: FYPO:0003232 ! normal histone H3-K9 methylation during vegetative growth
