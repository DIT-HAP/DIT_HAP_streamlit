property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2021-03-16T14:27:41Z" xsd:dateTime

[Term]
id: FYPO:0007685
name: increased vegetative cell population growth during nutrient starvation
def: "A cell growth phenotype in which vegetative cell population growth is increased relative to normal under conditions of starvation for one or more nutrients." [PMID:33574613, PomBase:mah]
synonym: "fast vegetative cell population growth during nutrient starvation" NARROW [PomBase:mah]
synonym: "increased vegetative cell population growth during nutrient depletion" EXACT [PomBase:mah]
synonym: "increased vegetative cell population growth during nutrient deprivation" EXACT [PomBase:mah]
synonym: "increased vegetative cell population growth during nutrient limitation" EXACT [PomBase:mah]
synonym: "increased vegetative cell population growth in response to nutrient starvation" EXACT [PomBase:mah]
synonym: "resistant to nutrient starvation" RELATED [PomBase:mah]
