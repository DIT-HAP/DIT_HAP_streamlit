synonym: "increased transcriptional response to nitrogen starvation" EXACT [PomBase:al]
is_a: FYPO:0002875 ! increased transcription
created_by: midori
creation_date: 2016-09-13T11:35:19Z

[Term]
id: FYPO:0005662
