is_a: FYPO:0006459 ! abnormal protein modification during meiotic cell cycle
created_by: vw
creation_date: 2023-01-25T14:50:38Z

[Term]
id: FYPO:0008051
name: decreased ubiquitin ligase activity
def: "A molecular function phenotype in which the observed rate of ubiquitin ligase activity is decreased." [PMID:28572513]
is_a: FYPO:0001912 ! abnormal ubiquitin ligase activity
property_value: http://purl.org/dc/elements/1.1/creator "vw253" xsd:string
