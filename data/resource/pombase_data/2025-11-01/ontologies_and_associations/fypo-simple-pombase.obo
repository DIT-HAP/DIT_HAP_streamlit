property_value: http://purl.org/dc/elements/1.1/date "2021-10-05T14:30:47Z" xsd:dateTime

[Term]
id: FYPO:0007871
name: decreased protein localization to lateral cell cortex, with protein distributed in cell cortex, during vegetative growth
def: "A cell phenotype observed in the vegetative growth phase of the life cycle in which the localization of a protein to the lateral cortex of a cell is decreased, and some of the protein is detected distributed throughout the cell cortex. There may be little or no protein detected at the medial cortex." [PMID:34533984, PomBase:mah]
synonym: "decreased protein localisation to lateral cell cortex, with protein distributed in cell cortex, during vegetative growth" EXACT [PomBase:mah]
synonym: "decreased protein localization to cell side, with protein distributed in cell cortex, during vegetative growth" RELATED [PomBase:vw]
synonym: "decreased protein localization to lateral cell cortex, with protein distributed in cell cortex, during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "decreased protein localization to lateral cortex, with protein distributed in cell cortex, during vegetative growth" EXACT [PomBase:vw]
synonym: "reduced protein localization to lateral cell cortex, with protein distributed in cell cortex, during vegetative growth" EXACT [PomBase:mah]
is_a: FYPO:0000928 ! abnormal protein localization to cell cortex during vegetative growth
is_a: FYPO:0007869 ! abnormal protein localization to lateral cell cortex
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2021-10-05T14:31:40Z" xsd:dateTime

[Term]
id: FYPO:0007872
name: abolished plasma membrane flow from cell pole to lateral region
def: "A cell phenotype observed in the vegetative growth phase of the life cycle in which bulk plasma membrane flow from the cell poles to lateral regions does not occur." [PMID:34533984, PomBase:mah]
synonym: "abolished bulk plasma membrane flow from cell pole to lateral region" EXACT [PomBase:mah]
synonym: "abolished plasma membrane flow from cell pole to lateral region during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "abolished plasma membrane flow from cell pole to lateral region during vegetative growth" EXACT [PomBase:mah]
synonym: "plasma membrane flow from cell pole to lateral region abolished" EXACT [PomBase:mah]
is_a: FYPO:0000813 ! abnormal plasma membrane organization
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2021-10-05T14:33:41Z" xsd:dateTime

[Term]
id: FYPO:0007873
name: abnormal exocytosis
def: "A cellular process phenotype in which exocytosis is abnormal. Exocytosis is the release of intracellular molecules (e.g. hormones, matrix proteins) contained within a membrane-bounded vesicle by fusion of the vesicle with the plasma membrane of a cell. A phenotype may affect exocytosis of all cargoes, or of specific cargo such as a particular protein." [GO:0006887, PomBase:mah]
synonym: "exocytosis defects" EXACT [PomBase:vw]
is_a: FYPO:0001720 ! abnormal transport
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2021-10-05T14:46:18Z" xsd:dateTime

[Term]
id: FYPO:0007874
name: decreased exocytosis at shmoo tip
def: "A cellular process phenotype in which exocytosis occurs to a lower extent than normal at the shmoo tip." [PMID:34382996, PomBase:mah]
synonym: "decreased exocytosis at mating projection tip" EXACT [PomBase:mah]
synonym: "decreased exocytosis at shmoo projection" EXACT [PomBase:mah]
synonym: "reduced exocytosis at shmoo tip" EXACT [PomBase:mah]
is_a: FYPO:0007873 ! abnormal exocytosis
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2021-10-05T14:49:23Z" xsd:dateTime

[Term]
id: FYPO:0007875
name: normal protein localization to actin fusion focus
def: "A cell phenotype in which the localization of a protein to the actin fusion focus is normal (i.e. indistinguishable from wild type)." [PMID:34382996, PomBase:mah]
synonym: "normal protein localisation to actin fusion focus" EXACT [PomBase:mah]
is_a: FYPO:0004096 ! normal protein localization to cytoskeleton
