property_value: http://purl.org/dc/elements/1.1/date "2023-05-12T10:56:00Z" xsd:dateTime

[Term]
id: FYPO:0008082
name: abnormal autophagy
def: "A cellular process phenotype in which autophagy is abnormal. Autophagy is the pathway by which cells digest parts of their own cytoplasm." [PMID:35406650]
is_a: FYPO:0000628 ! abnormal cellular process
property_value: http://purl.org/dc/elements/1.1/creator "vw253" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2023-06-07T08:25:03Z" xsd:dateTime

[Term]
id: FYPO:0008083
name: abnormal reticulophagy
def: "A cellular process phenotype in which autophagic degradation of the endoplasmic reticulum is abnormal." []
is_a: FYPO:0008082 ! abnormal autophagy
