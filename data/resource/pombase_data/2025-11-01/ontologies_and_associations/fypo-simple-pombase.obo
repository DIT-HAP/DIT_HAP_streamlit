property_value: http://purl.org/dc/elements/1.1/date "2021-06-03T14:45:48Z" xsd:dateTime

[Term]
id: FYPO:0007784
name: decreased protein localization to protein aggregate center
def: "A cell phenotype observed in the vegetative growth phase of the life cycle in which the localization of a protein to protein aggregate centers is decreased. Protein aggregate centers are composed of chaperones and misfolded proteins, and are reversibly formed in the nucleus and cytosol to shield thermosensitive proteins from degradation until conditions allow disaggregation and refolding." [PMID:32075773, PMID:33946513, PomBase:mah]
comment: We recommend noting which protein(s) were used in the assay when annotating to this term.
synonym: "decreased protein localisation to protein aggregate centre" EXACT [PomBase:mah]
synonym: "decreased protein localization to PAC" EXACT [PomBase:mah]
synonym: "decreased protein localization to PACs" EXACT [PomBase:vw]
synonym: "decreased protein localization to protein aggregate center during mitotic cell cycle" RELATED [PomBase:mah]
synonym: "decreased protein localization to protein aggregate center during vegetative growth" EXACT [PomBase:mah]
synonym: "reduced protein localization to protein aggregate center" EXACT [PomBase:mah]
is_a: FYPO:0000443 ! abnormal protein localization during vegetative growth
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2021-06-07T10:57:52Z" xsd:dateTime

[Term]
id: FYPO:0007785
name: abnormal cell cycle arrest at meiotic G2/MI transition
def: "A cellular process phenotype in which progression through the meiotic cell cycle is arrested at the G2/MI phase transition. Cells arrested at the G2/MI transition down-even in the presence of nutrients, in contrast with arrest at the mitotic G2/M transition, where cells continue to grow." [PMID:28476936, PomBase:jh, PomBase:mah]
synonym: "abnormal cell cycle arrest at G2/M1 transition" EXACT [PomBase:vw]
synonym: "abnormal cell cycle arrest at G2/MI transition of meiotic cell cycle" EXACT [GO:0008315]
synonym: "abnormal cell cycle arrest at meiotic cell cycle G2/MI phase transition" EXACT [GO:0008315]
synonym: "abnormal cell cycle arrest at meiotic G2/MI phase transition" EXACT [GO:0008315]
synonym: "abnormal meiotic cell cycle arrest at G2/MI phase transition" EXACT [PomBase:mah]
synonym: "abnormal meiotic cell cycle arrest at G2/MI transition" EXACT [PomBase:mah]
synonym: "abolished growth during meiotic cell cycle arrest at G2/M1" RELATED [PomBase:vw]
is_a: FYPO:0002224 ! abnormally arrested meiotic cell cycle
property_value: http://purl.org/dc/elements/1.1/creator "midori" xsd:string
property_value: http://purl.org/dc/elements/1.1/date "2021-06-07T12:12:49Z" xsd:dateTime

[Term]
id: FYPO:0007786
name: elongated cell with cell cycle arrest at meiotic G2/MI transition
def: "A cell phenotype in which the cell is longer than normal, and progression through the meiotic cell cycle is arrested at the G2/MI phase transition. A cell can elongate when arrested at the G2/MI transition if it overcomes the growth arrest that usually occurs." [PMID:28476936, PomBase:jh, PomBase:mah]
synonym: "elongated cell with abnormal cell cycle arrest at G2/M1 transition" EXACT [PomBase:vw]
synonym: "elongated cell with abnormal cell cycle arrest at G2/MI transition of meiotic cell cycle" EXACT [GO:0008315]
synonym: "elongated cell with abnormal cell cycle arrest at meiotic cell cycle G2/MI phase transition" EXACT [GO:0008315]
synonym: "elongated cell with abnormal cell cycle arrest at meiotic G2/MI phase transition" EXACT [GO:0008315]
synonym: "elongated cell with abnormal cell cycle arrest at meiotic G2/MI transition" EXACT [GO:0008315]
synonym: "elongated cell with abnormal meiotic cell cycle arrest at G2/MI phase transition" EXACT [PomBase:mah]
synonym: "elongated cell with abnormal meiotic cell cycle arrest at G2/MI transition" EXACT [PomBase:mah]
synonym: "elongated cells during meiotic G2/M1 arrest" EXACT [PomBase:vw]
synonym: "elongated cells during meiotic G2/MI arrest" EXACT [PomBase:vw]
synonym: "long cell with cell cycle arrest at meiotic G2/MI transition" EXACT [PomBase:mah]
